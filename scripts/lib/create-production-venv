#!/usr/bin/env python3
import argparse
import os
import platform
import sys
from pathlib import Path
from tempfile import TemporaryDirectory

ZULIP_PATH = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
if ZULIP_PATH not in sys.path:
    sys.path.append(ZULIP_PATH)

from scripts.lib.select_native_wheel import (
    RELEASE_WHEEL_DIR,
    select_wheel,
    supported_wheel_platform,
)
from scripts.lib.setup_venv import get_venv_dependencies
from scripts.lib.zulip_tools import os_families, run, su_to_zulip

parser = argparse.ArgumentParser(description="Create a production virtualenv with caching")
parser.add_argument("deploy_path")
parser.add_argument(
    "--rust-wheel-dir", type=Path, help="Install a staged native wheel from this directory"
)
parser.add_argument("--git-deployment", action="store_true", help=argparse.SUPPRESS)
parser.add_argument("--check-rust-wheel", action="store_true", help=argparse.SUPPRESS)
args = parser.parse_args()
distro_info = platform.freedesktop_os_release()
wheel = None
wheel_dir = args.rust_wheel_dir
machine = platform.machine()
wheel_supported = supported_wheel_platform(distro_info, machine)
root = Path(args.deploy_path).resolve()
is_git_checkout = (root / ".git").exists()
if args.git_deployment and (wheel_dir is None or not is_git_checkout):
    parser.error("Git wheel installation requires a staged wheel and a deployment checkout")
if wheel_dir is None and wheel_supported and not is_git_checkout:
    bundled = root / RELEASE_WHEEL_DIR
    if bundled.exists() or bundled.is_symlink():
        wheel_dir = bundled

if wheel_dir is not None:
    if not wheel_supported:
        parser.error("staged Rust wheels are only supported on Ubuntu 24.04 x86-64")
    if root != Path(ZULIP_PATH).resolve():
        parser.error("native wheel must be installed into the invoking checkout")
    # Deployment Git worktrees belong to the service user. Do not relax
    # Git's ownership checks to inspect them from this root process.
    git_preexec = su_to_zulip if args.git_deployment and os.geteuid() == 0 else None
    wheel = select_wheel(root, wheel_dir.absolute(), machine, git_preexec=git_preexec)

if args.check_rust_wheel:
    if wheel is None:
        parser.error("No staged Rust wheel to check")
    sys.exit(0)

# install dependencies for setting up the virtualenv
vendor = distro_info["ID"]
os_version = distro_info["VERSION_ID"]
VENV_DEPENDENCIES = get_venv_dependencies(vendor, os_version)
if "debian" in os_families():
    run(["apt-get", "-y", "install", "--no-install-recommends", *VENV_DEPENDENCIES])
elif "fedora" in os_families():
    run(["yum", "-y", "install", *VENV_DEPENDENCIES])
else:
    print("Unsupported platform: {}".format(distro_info["ID"]))
    sys.exit(1)

os.chdir(ZULIP_PATH)
run(["scripts/lib/install-uv"])
run(
    ["uv", "sync", "--frozen", "--no-managed-python", "--only-group=prod"],
    env={k: v for k, v in os.environ.items() if k not in {"PYTHONDEVMODE", "PYTHONWARNINGS"}},
)

if wheel is not None:
    path, sha256 = wheel
    venv = Path(os.environ.get("UV_PROJECT_ENVIRONMENT") or ".venv")
    with TemporaryDirectory(prefix="zulip-native-wheel-") as directory:
        requirements = Path(directory) / "wheel-requirements.txt"
        requirements.write_text(f"zulip-backend @ {path.as_uri()} --hash=sha256:{sha256}\n")
        run(
            [
                "uv",
                "pip",
                "install",
                "--offline",
                "--no-index",
                "--no-deps",
                "--require-hashes",
                "--python",
                str(venv.absolute() / "bin/python"),
                "--requirements",
                str(requirements),
            ]
        )
